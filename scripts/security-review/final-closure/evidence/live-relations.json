    "reloptions": null,
    "view_definition": " SELECT COALESCE(c.class_level, q.class_level::integer) AS class_level,\n    COALESCE(c.subject, q.subject) AS subject,\n    c.id AS chapter_id,\n    COALESCE(c.chapter_name, c.name, q.chapter) AS chapter_name,\n    count(*) FILTER (WHERE q.is_active) AS usable_questions,\n    count(*) FILTER (WHERE NOT q.is_active) AS hidden_questions,\n    count(*) AS total_questions\n   FROM questions q\n     LEFT JOIN chapters c ON c.id = q.chapter_id\n  GROUP BY (COALESCE(c.class_level, q.class_level::integer)), (COALESCE(c.subject, q.subject)), c.id, (COALESCE(c.chapter_name, c.name, q.chapter));"
  },
